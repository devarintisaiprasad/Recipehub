    {
      "name": "5. Chef AI (RAG)",
      "item": [
        {
          "name": "Ask Chef AI",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/assistant/ask",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assistant",
                "ask"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"I have chicken and rice, what can I cook?\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "description": "If you get indexed:false, log in as admin and run 'Index recipes' first."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Has indexed flag\", function () { pm.expect(pm.response.json()).to.have.property(\"indexed\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Ask with empty question (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
