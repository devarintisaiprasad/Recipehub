    {
      "name": "6. Admin (role based)",
      "item": [
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "description": "Set adminEmail and adminPassword in the collection Variables. The first user who signed up in the app is the admin."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test(\"Token received\", function () { pm.expect(j.token).to.be.a(\"string\"); });",
                  "pm.collectionVariables.set(\"adminToken\", j.token);",
                  "pm.collectionVariables.set(\"adminTokenUserId\", j.user.id);"
                ]
              }
            }
          ]
        },
