# Copy this file to ".env" in the same folder and fill in your own values.
# NEVER commit the real .env file to GitHub.

# PostgreSQL connection: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# The database is created automatically if it does not exist.
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/recipehub

# A long random text used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

PORT=5000

# Optional: accounts created at start-up if they do not exist yet.
# Leave empty to skip. If empty, the first person who signs up becomes admin.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_EMPLOYEE_EMAIL=
SEED_EMPLOYEE_PASSWORD=

# Optional: this email becomes admin when it signs up
ADMIN_EMAIL=

# Optional: enables AI-written answers in Chef AI. Leave empty for the basic answer mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
